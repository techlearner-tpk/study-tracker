generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum LearningStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum HabitGoalMetric {
  STUDY_MINUTES_DAILY
  STUDY_DAYS_WEEKLY
  STUDY_SESSION_DAILY
}

enum OutcomeGoalType {
  COMPLETE_TOPIC
  COMPLETE_CHAPTER
}

enum UserRole {
  PARENT
  KID
}

enum MagicLinkType {
  SIGNUP
  SIGNIN
  INVITE
}

enum CurriculumStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CurriculumVerificationStatus {
  OFFICIAL
  VERIFIED_FROM_OFFICIAL_SOURCE
  CURATED_FROM_OFFICIAL_SOURCE
  REVIEW_REQUIRED
}

enum AssignmentSource {
  PARENT
  SELF
}

enum AssignmentType {
  STUDY
  PRACTICE
  REVISION
  TEST
}

enum AssignmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  SKIPPED
}

enum AssignmentPriority {
  LOW
  MEDIUM
  HIGH
}

enum SubscriptionStatus {
  FREE
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum AiLearningMode {
  TEACH
  TEST
}

enum AiSessionStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum AiLearningMessageRole {
  SYSTEM
  CHILD
  ASSISTANT
}

enum TestTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OnlineTestQuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_IN_THE_BLANK
  VERY_SHORT_ANSWER
  SHORT_ANSWER
  LONG_ANSWER
  NUMERICAL
  CASE_BASED
  ASSERTION_REASON
  READING_COMPREHENSION
  GRAMMAR
  WRITING
  VOCABULARY
}

enum OnlineTestDifficulty {
  EASY
  MEDIUM
  HARD
  MIXED
}

enum OnlineTestPaperSource {
  ASSIGNED_BY_PARENT
  SELF_PRACTICE
}

enum OnlineTestPaperStatus {
  GENERATING
  REVIEWING
  DRAFT
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  ARCHIVED
  FAILED
}

enum OnlineTestAiReviewStatus {
  PENDING
  PASSED
  FAILED
  NEEDS_REVIEW
}

enum OnlineTestAttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  NEEDS_REVIEW
}

enum AiQuotaReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
  FAILED
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  name          String
  passwordHash  String
  clerkUserId   String?           @unique
  role          UserRole          @default(PARENT)
  verifiedAt    DateTime?
  childId       String?           @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  child         Child?            @relation("KidChild", fields: [childId], references: [id], onDelete: Cascade)
  children      Child[]           @relation("ParentChildren")
  assignments   Assignment[]      @relation("AssignmentsCreatedBy")
  subscription  Subscription?     @relation("ParentSubscription")
  testTemplates TestTemplate[]    @relation("TestTemplatesCreatedBy")
  testPapers    OnlineTestPaper[] @relation("OnlineTestPapersCreatedBy")
}

model Child {
  id                    String                    @id @default(cuid())
  userId                String?
  name                  String
  className             String
  school                String?
  themeColor            String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  user                  User?                     @relation("ParentChildren", fields: [userId], references: [id], onDelete: Cascade)
  kidUser               User?                     @relation("KidChild")
  magicLinkTokens       MagicLinkToken[]
  subjects              Subject[]
  habitGoals            HabitGoal[]
  outcomeGoals          OutcomeGoal[]
  curriculumAssignments CurriculumAssignment[]
  assignments           Assignment[]
  aiTopicUsages         AiTopicUsage[]
  aiLearningSessions    AiLearningSession[]
  aiTestAttempts        AiTestAttempt[]
  onlineTestPapers      OnlineTestPaper[]
  onlineTestAttempts    OnlineTestAttempt[]
  aiQuotaReservations   AiTopicUsageReservation[]

  @@index([name])
  @@index([userId])
}

model CurriculumBoard {
  id            String              @id @default(cuid())
  code          String              @unique
  name          String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  versions      CurriculumVersion[]
  testTemplates TestTemplate[]
}

model CurriculumVersion {
  id                    String                       @id @default(cuid())
  boardId               String
  academicYear          String
  version               String
  name                  String
  status                CurriculumStatus             @default(DRAFT)
  verificationStatus    CurriculumVerificationStatus @default(REVIEW_REQUIRED)
  sourceUrl             String?
  notes                 String?
  sourceReferences      Json?
  publishedAt           DateTime?
  archivedAt            DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  board                 CurriculumBoard              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  classes               CurriculumClass[]
  curriculumAssignments CurriculumAssignment[]

  @@unique([boardId, academicYear, version])
  @@index([boardId])
  @@index([status])
}

model CurriculumClass {
  id                    String                 @id @default(cuid())
  versionId             String
  level                 Int
  name                  String
  stableKey             String
  sequence              Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  version               CurriculumVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  subjects              CurriculumSubject[]
  curriculumAssignments CurriculumAssignment[]
  testTemplates         TestTemplate[]

  @@unique([versionId, level])
  @@unique([versionId, stableKey])
  @@index([versionId])
}

model CurriculumSubject {
  id                 String                       @id @default(cuid())
  classId            String
  stableKey          String
  name               String
  sequence           Int                          @default(0)
  isDefaultSelected  Boolean                      @default(false)
  isOptional         Boolean                      @default(false)
  isLanguageSubject  Boolean                      @default(false)
  sourceUrl          String?
  verificationStatus CurriculumVerificationStatus @default(REVIEW_REQUIRED)
  archivedAt         DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  class              CurriculumClass              @relation(fields: [classId], references: [id], onDelete: Cascade)
  chapters           CurriculumChapter[]

  @@unique([classId, stableKey])
  @@index([classId])
  @@index([archivedAt])
}

model CurriculumChapter {
  id                 String                       @id @default(cuid())
  subjectId          String
  stableKey          String
  name               String
  sequence           Int                          @default(0)
  sourceUrl          String?
  verificationStatus CurriculumVerificationStatus @default(REVIEW_REQUIRED)
  archivedAt         DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  subject            CurriculumSubject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics             CurriculumTopic[]

  @@unique([subjectId, stableKey])
  @@index([subjectId])
  @@index([archivedAt])
}

model CurriculumTopic {
  id                 String                       @id @default(cuid())
  chapterId          String
  stableKey          String
  name               String
  sequence           Int                          @default(0)
  sourceUrl          String?
  verificationStatus CurriculumVerificationStatus @default(REVIEW_REQUIRED)
  archivedAt         DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  chapter            CurriculumChapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, stableKey])
  @@index([chapterId])
  @@index([archivedAt])
}

model CurriculumAssignment {
  id                  String            @id @default(cuid())
  childId             String            @unique
  curriculumVersionId String
  curriculumClassId   String
  selectedSubjectIds  String[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  child               Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  curriculumVersion   CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  curriculumClass     CurriculumClass   @relation(fields: [curriculumClassId], references: [id], onDelete: Restrict)
  subjects            Subject[]
  chapters            Chapter[]
  topics              Topic[]
}

model Assignment {
  id                    String              @id @default(cuid())
  childId               String
  topicId               String
  assignedByUserId      String
  source                AssignmentSource
  type                  AssignmentType
  status                AssignmentStatus    @default(PLANNED)
  priority              AssignmentPriority  @default(MEDIUM)
  isActive              Boolean             @default(true)
  plannedDate           DateTime?
  dueDate               DateTime?
  instructions          String?
  studySessionTarget    Int?
  practiceSessionTarget Int?
  questionTarget        Int?
  maximumMarks          Int?
  passingMarks          Int?
  durationMinutes       Int?
  score                 Int?
  completedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  child                 Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  topic                 Topic               @relation(fields: [topicId], references: [id], onDelete: Restrict)
  assignedBy            User                @relation("AssignmentsCreatedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  studySessions         StudySession[]
  practiceSessions      PracticeSession[]
  revisionSessions      RevisionSession[]
  aiLearningSessions    AiLearningSession[]
  aiTestAttempts        AiTestAttempt[]

  @@index([childId])
  @@index([topicId])
  @@index([assignedByUserId])
  @@index([status])
  @@index([dueDate])
}

model MagicLinkToken {
  id        String        @id @default(cuid())
  email     String
  type      MagicLinkType
  tokenHash String        @unique
  childId   String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  child     Child?        @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([childId])
  @@index([expiresAt])
}

model Subject {
  id                     String                @id @default(cuid())
  childId                String
  name                   String
  color                  String?
  order                  Int                   @default(0)
  curriculumAssignmentId String?
  curriculumVersionId    String?
  curriculumSubjectId    String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  child                  Child                 @relation(fields: [childId], references: [id], onDelete: Cascade)
  curriculumAssignment   CurriculumAssignment? @relation(fields: [curriculumAssignmentId], references: [id], onDelete: SetNull)
  chapters               Chapter[]
  testTemplates          TestTemplate[]
  onlineTestPapers       OnlineTestPaper[]

  @@unique([childId, name])
  @@index([childId])
  @@index([curriculumVersionId])
  @@index([curriculumAssignmentId])
}

model Chapter {
  id                     String                 @id @default(cuid())
  subjectId              String
  name                   String
  order                  Int                    @default(0)
  curriculumAssignmentId String?
  curriculumVersionId    String?
  curriculumSubjectId    String?
  curriculumChapterId    String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  subject                Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  curriculumAssignment   CurriculumAssignment?  @relation(fields: [curriculumAssignmentId], references: [id], onDelete: SetNull)
  topics                 Topic[]
  onlineTestTopics       OnlineTestPaperTopic[]
  onlineTestQuestions    OnlineTestQuestion[]

  @@index([subjectId])
  @@index([curriculumVersionId])
  @@index([curriculumAssignmentId])
}

model Topic {
  id                     String                    @id @default(cuid())
  chapterId              String
  name                   String
  description            String?
  status                 LearningStatus            @default(NOT_STARTED)
  confidenceRating       Int?
  notes                  String?
  order                  Int                       @default(0)
  curriculumAssignmentId String?
  curriculumVersionId    String?
  curriculumSubjectId    String?
  curriculumChapterId    String?
  curriculumTopicId      String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  completedAt            DateTime?
  chapter                Chapter                   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  curriculumAssignment   CurriculumAssignment?     @relation(fields: [curriculumAssignmentId], references: [id], onDelete: SetNull)
  studySessions          StudySession[]
  practiceSessions       PracticeSession[]
  revisionSessions       RevisionSession[]
  assignments            Assignment[]
  aiTopicUsages          AiTopicUsage[]
  aiLearningSessions     AiLearningSession[]
  aiTestAttempts         AiTestAttempt[]
  onlineTestTopics       OnlineTestPaperTopic[]
  onlineTestQuestions    OnlineTestQuestion[]
  aiQuotaReservations    AiTopicUsageReservation[]

  @@index([chapterId])
  @@index([status])
  @@index([curriculumVersionId])
  @@index([curriculumAssignmentId])
}

model StudySession {
  id              String      @id @default(cuid())
  topicId         String
  assignmentId    String?
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int
  notes           String?
  createdAt       DateTime    @default(now())
  topic           Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  assignment      Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([topicId])
  @@index([assignmentId])
  @@index([startTime])
}

model PracticeSession {
  id                 String      @id @default(cuid())
  topicId            String
  assignmentId       String?
  date               DateTime
  durationMinutes    Int
  questionsAttempted Int?
  questionsCorrect   Int?
  notes              String?
  createdAt          DateTime    @default(now())
  topic              Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  assignment         Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([topicId])
  @@index([assignmentId])
  @@index([date])
}

model RevisionSession {
  id              String      @id @default(cuid())
  topicId         String
  assignmentId    String?
  date            DateTime
  durationMinutes Int
  notes           String?
  createdAt       DateTime    @default(now())
  topic           Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  assignment      Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([topicId])
  @@index([assignmentId])
  @@index([date])
}

model Subscription {
  id        String             @id @default(cuid())
  parentId  String             @unique
  status    SubscriptionStatus @default(FREE)
  planCode  String?
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  parent    User               @relation("ParentSubscription", fields: [parentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([expiresAt])
}

model AiSetting {
  id                        Int      @id @default(1)
  topicPromptLimit          Int?
  testQuestionCount         Int?
  maxUserPromptLength       Int?
  testPaperMaxQuestions     Int?
  testPaperRetryCount       Int?
  evaluationReviewThreshold Float?
  testAutosaveIntervalMs    Int?
  updatedAt                 DateTime @updatedAt
  createdAt                 DateTime @default(now())
}

model AiRequestLog {
  id        String   @id @default(cuid())
  requestId String   @unique
  operation String
  sessionId String?
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operation])
  @@index([sessionId])
}

model AiTopicUsage {
  id           String                    @id @default(cuid())
  childId      String
  topicId      String
  promptCount  Int                       @default(0)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  child        Child                     @relation(fields: [childId], references: [id], onDelete: Cascade)
  topic        Topic                     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  reservations AiTopicUsageReservation[]

  @@unique([childId, topicId])
  @@index([childId])
  @@index([topicId])
}

model AiTopicUsageReservation {
  id          String                   @id @default(cuid())
  requestId   String
  childId     String
  topicId     String
  usageId     String?
  testPaperId String?
  status      AiQuotaReservationStatus @default(RESERVED)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  child       Child                    @relation(fields: [childId], references: [id], onDelete: Cascade)
  topic       Topic                    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  usage       AiTopicUsage?            @relation(fields: [usageId], references: [id], onDelete: SetNull)
  testPaper   OnlineTestPaper?         @relation(fields: [testPaperId], references: [id], onDelete: Cascade)

  @@unique([requestId, topicId])
  @@index([childId, topicId, status])
  @@index([testPaperId])
}

model TestTemplate {
  id              String                @id @default(cuid())
  name            String
  boardId         String?
  classId         String?
  subjectId       String?
  subjectName     String
  totalMarks      Int
  durationMinutes Int
  difficulty      OnlineTestDifficulty  @default(MIXED)
  status          TestTemplateStatus    @default(DRAFT)
  createdByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  board           CurriculumBoard?      @relation(fields: [boardId], references: [id], onDelete: SetNull)
  class           CurriculumClass?      @relation(fields: [classId], references: [id], onDelete: SetNull)
  subject         Subject?              @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdBy       User                  @relation("TestTemplatesCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sections        TestTemplateSection[]
  testPapers      OnlineTestPaper[]

  @@index([status])
  @@index([subjectName])
  @@index([createdByUserId])
}

model TestTemplateSection {
  id           String             @id @default(cuid())
  templateId   String
  name         String
  instructions String?
  order        Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  template     TestTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  rules        TestTemplateRule[]

  @@index([templateId])
}

model TestTemplateRule {
  id                  String                 @id @default(cuid())
  sectionId           String
  questionType        OnlineTestQuestionType
  marksPerQuestion    Int
  questionCount       Int
  difficulty          OnlineTestDifficulty   @default(MEDIUM)
  internalChoiceCount Int                    @default(0)
  order               Int                    @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  section             TestTemplateSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

model OnlineTestPaper {
  id                  String                    @id @default(cuid())
  childId             String
  subjectId           String
  templateId          String
  createdByUserId     String
  source              OnlineTestPaperSource
  title               String
  totalMarks          Int
  durationMinutes     Int
  difficulty          OnlineTestDifficulty      @default(MIXED)
  status              OnlineTestPaperStatus     @default(DRAFT)
  aiReviewStatus      OnlineTestAiReviewStatus  @default(PENDING)
  generationRequestId String?
  aiReviewJson        Json?
  dueAt               DateTime?
  assignedAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  child               Child                     @relation(fields: [childId], references: [id], onDelete: Cascade)
  subject             Subject                   @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  template            TestTemplate              @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdBy           User                      @relation("OnlineTestPapersCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  topics              OnlineTestPaperTopic[]
  sections            OnlineTestSection[]
  questions           OnlineTestQuestion[]
  attempts            OnlineTestAttempt[]
  quotaReservations   AiTopicUsageReservation[]

  @@index([childId])
  @@index([subjectId])
  @@index([templateId])
  @@index([createdByUserId])
  @@index([status])
}

model OnlineTestPaperTopic {
  id                     String          @id @default(cuid())
  testPaperId            String
  topicId                String
  chapterId              String
  allocatedMarks         Int
  allocatedQuestionCount Int
  createdAt              DateTime        @default(now())
  testPaper              OnlineTestPaper @relation(fields: [testPaperId], references: [id], onDelete: Cascade)
  topic                  Topic           @relation(fields: [topicId], references: [id], onDelete: Restrict)
  chapter                Chapter         @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  @@unique([testPaperId, topicId])
  @@index([topicId])
  @@index([chapterId])
}

model OnlineTestSection {
  id           String               @id @default(cuid())
  testPaperId  String
  name         String
  instructions String?
  order        Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  testPaper    OnlineTestPaper      @relation(fields: [testPaperId], references: [id], onDelete: Cascade)
  questions    OnlineTestQuestion[]

  @@index([testPaperId])
}

model OnlineTestQuestion {
  id                String                   @id @default(cuid())
  testPaperId       String
  sectionId         String
  chapterId         String
  topicId           String
  questionType      OnlineTestQuestionType
  questionText      String
  optionsJson       Json?
  correctAnswerJson Json
  markingSchemeJson Json
  explanation       String
  marks             Int
  difficulty        OnlineTestDifficulty     @default(MEDIUM)
  order             Int                      @default(0)
  aiReviewStatus    OnlineTestAiReviewStatus @default(PENDING)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  testPaper         OnlineTestPaper          @relation(fields: [testPaperId], references: [id], onDelete: Cascade)
  section           OnlineTestSection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  chapter           Chapter                  @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  topic             Topic                    @relation(fields: [topicId], references: [id], onDelete: Restrict)
  answers           OnlineTestAnswer[]

  @@index([testPaperId])
  @@index([sectionId])
  @@index([topicId])
}

model OnlineTestAttempt {
  id              String                  @id @default(cuid())
  testPaperId     String
  childId         String
  status          OnlineTestAttemptStatus @default(NOT_STARTED)
  startedAt       DateTime?
  submittedAt     DateTime?
  evaluatedAt     DateTime?
  aiAwardedMarks  Float?
  finalMarks      Float?
  percentage      Float?
  overallFeedback String?
  strengthsJson   Json?
  weakAreasJson   Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  testPaper       OnlineTestPaper         @relation(fields: [testPaperId], references: [id], onDelete: Cascade)
  child           Child                   @relation(fields: [childId], references: [id], onDelete: Cascade)
  answers         OnlineTestAnswer[]

  @@index([testPaperId])
  @@index([childId])
  @@index([status])
}

model OnlineTestAnswer {
  id                   String             @id @default(cuid())
  attemptId            String
  questionId           String
  answerText           String?
  answerJson           Json?
  aiAwardedMarks       Float?
  finalMarks           Float?
  aiFeedback           String?
  parentFeedback       String?
  evaluationConfidence Float?
  needsReview          Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  attempt              OnlineTestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question             OnlineTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model AiLearningSession {
  id            String              @id @default(cuid())
  childId       String
  topicId       String
  assignmentId  String?
  mode          AiLearningMode
  status        AiSessionStatus     @default(ACTIVE)
  provider      String
  model         String
  promptVersion String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  child         Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  topic         Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  assignment    Assignment?         @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  messages      AiLearningMessage[]
  testAttempt   AiTestAttempt?

  @@index([childId])
  @@index([topicId])
  @@index([assignmentId])
  @@index([status])
  @@index([mode])
}

model AiLearningMessage {
  id        String                @id @default(cuid())
  sessionId String
  role      AiLearningMessageRole
  content   String
  sequence  Int
  createdAt DateTime              @default(now())
  session   AiLearningSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([sessionId])
}

model AiTestAttempt {
  id              String            @id @default(cuid())
  sessionId       String            @unique
  childId         String
  topicId         String
  assignmentId    String?
  questionCount   Int
  correctCount    Int
  scorePercentage Int
  startedAt       DateTime
  submittedAt     DateTime?
  questionsJson   Json
  answersJson     Json?
  evaluationJson  Json?
  createdAt       DateTime          @default(now())
  session         AiLearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  child           Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  topic           Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  assignment      Assignment?       @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([childId])
  @@index([topicId])
  @@index([assignmentId])
}

model HabitGoal {
  id          String          @id @default(cuid())
  childId     String
  title       String
  metric      HabitGoalMetric
  targetValue Int
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  child       Child           @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
}

model OutcomeGoal {
  id              String          @id @default(cuid())
  childId         String
  title           String
  type            OutcomeGoalType
  targetTopicId   String?
  targetChapterId String?
  dueDate         DateTime?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  child           Child           @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([targetTopicId])
  @@index([targetChapterId])
}
